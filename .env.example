FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-this-with-a-secure-secret-key
DATABASE_URL=sqlite:///app.db
# Replace DATABASE_URL with your Supabase PostgreSQL connection string, e.g.:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres

# WhatsApp Configuration (Optional for notifications)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_TOKEN=your-whatsapp-access-token

# Supabase Storage Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_KEY=your-supabase-anon-key
